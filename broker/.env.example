# Copy to .env (never commit .env). `aio app use` adds AIO_runtime_* values.

# 32 random bytes, base64. Wraps the per-record data keys (envelope encryption).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BLOCKSOURCE_ENCRYPTION_KEY=

# Optional: nightly usage scan. OAuth server-to-server credential with read access in DA.
BLOCKSOURCE_IMS_CLIENT_ID=
BLOCKSOURCE_IMS_CLIENT_SECRET=
BLOCKSOURCE_IMS_SCOPES=openid,AdobeID,read_organizations
